# URL da API do Leafy (se o servidor rodar em outro PC na mesma rede, use o IP do servidor: http://192.168.1.X:8001/assistente)
LEAFY_API_URL=http://localhost:8001/assistente

# Modo de acionamento: continuous, push_to_talk, text
LEAFY_TRIGGER_MODE=continuous

# Motores de STT (reconhecimento de fala): auto, speech_recognition, keyboard, mock
LEAFY_STT_ENGINE=auto
LEAFY_STT_LANGUAGE=pt-BR

# Motores de TTS (síntese de voz): auto, espeak, pyttsx3, gtts, mock
LEAFY_TTS_ENGINE=auto
LEAFY_TTS_VOICE_RATE=165
LEAFY_TTS_LANGUAGE=pt-BR

# Sensibilidade do microfone
LEAFY_ENERGY_THRESHOLD=300
LEAFY_PAUSE_THRESHOLD=1.0
